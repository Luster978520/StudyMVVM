<Window x:Class="StudyMVVM.Views.LogicView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudyMVVM.Views"
        mc:Ignorable="d"
        xmlns:custPwdNS="clr-namespace:StudyMVVM.Common"
        Title="LogicView" Height="550" Width="800">
    <Grid>
        <Grid>
            <!-- 整体布局：两行，第一行蓝色标题，第二行左右分栏 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部蓝色标题栏 -->
            <Border Grid.Row="0" Background="#0078D7">
                <TextBlock Text="用户登录" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 主体左右分栏 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：浅蓝背景 + 用户头像 -->
                <Border Grid.Column="0" Background="#B0E0E6">
                    <Viewbox Width="160" Height="160">
                        <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,6A4,4 0 0,1 16,10A4,4 0 0,1 12,14A4,4 0 0,1 8,10A4,4 0 0,1 12,6M12,16C14.67,16 17,17.27 17,18V19H7V18C7,17.27 9.33,16 12,16Z" Fill="Black" Stretch="Uniform"/>
                    </Viewbox>
                </Border>

                <!-- 右侧：淡青色背景，账号密码表单 -->
                <Border Grid.Column="1" Background="#E0FFFF">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- 账号行 -->
                        <StackPanel Orientation="Horizontal" Margin="0 10">
                            <TextBlock Text="账号" FontSize="18" Width="60" VerticalAlignment="Center"/>
                            <TextBox Width="220" Height="30" FontSize="16" Text="{Binding Account}"/>
                        </StackPanel>

                       
                        <!-- 密码行 -->
                        <StackPanel Orientation="Horizontal" Margin="0 10">
                            <TextBlock Text="密码" FontSize="18" Width="60" VerticalAlignment="Center"/>
                            <PasswordBox  Width="220" Height="30" FontSize="16" custPwdNS:pwdAttachHelper2.CustPwd="{Binding Pwd, Mode=TwoWay}"
                                          custPwdNS:pwdAttachHelper2.IsOpen="True"/>



                        </StackPanel>
                        <StackPanel> 
                      <!-- 登录按钮 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        <Button  Content="登录" FontSize="22" Width="140" Height="40" Margin="0 10 0 0" Background="#ADD8E6"  Command="{Binding LoginCommand}" />
                        <Button  Content="shape" FontSize="22" Width="140" Height="40" Margin="0 10 0 0" Background="#ADD8E6"  Click="Button_Click" />
                        <Button Content="paintBlock" FontSize="22" Width="140" Height="40" Margin="0 10 0 0" Background="#ADD8E6"  Click="Button_Click_1" />
                        <Button Content="effect" FontSize="22" Width="140" Height="40" Margin="0 10 0 0" Background="#ADD8E6"  Click="Button_Click_2"/>
                        <Button Content="playFrm" FontSize="22" Width="140" Height="40" Margin="0 10 0 0" Background="#ADD8E6"  Click="Button_Click_3"/>
                        <Button Content="RotateFrm" FontSize="22" Width="140" Height="40" Margin="0 10 0 0" Background="#ADD8E6"  Click="Button_Click_4"/>
                        </StackPanel>

                    </StackPanel>
                    
                </Border>
                <Border Grid.Column="2" Background="#E0FFF0">
                    <ScrollViewer>
                        <StackPanel>
                            <Button Content="ControlTemplate" FontSize="15" Width="140" Height="40" Margin="2 10 0 0" Background="#ADD8E6"  Click="Button_Click_5"/>
                            <Button Content="test" FontSize="15" Width="140" Height="40" Margin="2 10 0 0" Background="#ADD8E6" Click="OpenTemplateLab_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

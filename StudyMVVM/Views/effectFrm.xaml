<Window x:Class="StudyMVVM.Views.effectFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudyMVVM.Views"
        mc:Ignorable="d"
        Title="effectFrm" Height="450" Width="800">
    <TabControl SelectedIndex="1">
        <TabItem Header="effect">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62.678"/>
                    <ColumnDefinition Width="267.322"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="10 20 10 20" Content="点击我" Width="150" Height="50">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="{Binding ElementName=shadowBlurRadius, Path=Value}" Color="Pink" Opacity="{Binding ElementName=shadowOpacity, Path=Value}" Direction="{Binding ElementName=shadowBlurRadius, Path=Value}" ShadowDepth="{Binding ElementName=shadowDepth, Path=Value}"/>
                            </Button.Effect>
                        </Button>
                        <Button Margin="10 0 0 0" Content="点击我" Width="150" Height="50">
                        </Button>
                    </StackPanel>
                    <TextBlock Text="模糊半径"></TextBlock>
                    <ScrollBar Orientation="Horizontal"  Margin="0 10 0 0" Background="Bisque" x:Name="shadowBlurRadius" Minimum="0" Maximum="30" Value="10 "></ScrollBar>
                    <TextBlock Text="Opacity"></TextBlock>
                    <ScrollBar Orientation="Horizontal" Margin="0 10 0 0" Background="Bisque" x:Name="shadowOpacity" Minimum="0" Maximum="30" Value="10 "></ScrollBar>
                    <TextBlock Text="Direction"></TextBlock>
                    <ScrollBar Orientation="Horizontal" Margin="0 10 0 0" Background="Bisque" x:Name="shadowDirect" Minimum="0" Maximum="360" Value="10 "></ScrollBar>
                    <TextBlock Text="depth"></TextBlock>
                    <ScrollBar  Orientation="Horizontal" Margin="0 10 0 0" Background="Bisque" x:Name="shadowDepth" Minimum="0" Maximum="50" Value="10 "></ScrollBar>
                </StackPanel>
                <StackPanel Width="20" Grid.Column="2" >
                    <ScrollBar Background="AliceBlue"></ScrollBar>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3">
                    <TextBlock TextWrapping="Wrap"  Text="给button添加Button.effect  DropShadowEffect 可以把Effect理解为：在WPF把UI元素绘制出来，对齐结果进行额外的图像处理
                       属性有 BlurRadius  Color  Opacity  Direction  ShadowDepth
                       "/>
                </StackPanel>


                <StackPanel Margin="0,10,0,0" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid Background="#101020">
                        <Ellipse Width="150"  Height="150" Fill="#001E3C" Stroke="#00FFFF" StrokeThickness="3">
                            <Ellipse.Effect>
                                <DropShadowEffect
                Color="#00FFFF"
                BlurRadius="30"
                ShadowDepth="0"
                Opacity="1"/>
                            </Ellipse.Effect>

                        </Ellipse>

                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,258,0,0" Grid.RowSpan="2">
                    <TextBlock TextWrapping="Wrap" Text="UIElement 的依赖属性DropshadowEffect
                       这里最关键的是： ShadowDepth=0 阴影不再向某个方向偏移，而是围绕着图形扩散。"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock> 后台代码</TextBlock>
                    <Button   Width="100" Height="100" x:Name="TestEffectBtn"></Button>

                    <Button Content="鼠标移入试试" Margin="10 10 10 10"
        Width="180"
        Height="55"
        Background="#202040"
        Foreground="White">

                        <Button.Effect>
                            <DropShadowEffect
            Color="Cyan"
            BlurRadius="5"
            ShadowDepth="0"
            Opacity="0.7"/>
                        </Button.Effect>

                        <Button.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                        Storyboard.TargetProperty="Effect.BlurRadius"
                        To="30"
                        Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                        Storyboard.TargetProperty="Effect.BlurRadius"
                        To="5"
                        Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>

                    </Button>

                </StackPanel>



            </Grid>
        </TabItem>
        <TabItem Header="动画">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="25*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="763*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="4">
                    <Button x:Name="btnAnim" Content="动画按钮" Width="100" Height="100" Background="Blue">
                        <Button.Triggers>
                            <EventTrigger  RoutedEvent="Button.Click">
                                <BeginStoryboard >
                                    <Storyboard>
                                        <DoubleAnimation
     Storyboard.TargetName="btnAnim"
    Storyboard.TargetProperty="Opacity"
    From="1"
    To="0.2"
    Duration="0:0:0.8"
    AutoReverse="True"
    RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                    <Ellipse Width="200" Height="120" Fill="Red">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="MouseMove">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To=" 0" Duration="0:0:0.5" RepeatBehavior="Forever" AutoReverse="True" ></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>

                    </Ellipse>

                    <Button x:Name="btnTestAnimation" Click="Button_Click" Content="按钮大小" Width="100" Height="50"></Button>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem>
            <Grid>
                <Button Height="50" Width="100" Background="Aquamarine">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <EventTrigger.Actions>
                                <BeginStoryboard HandoffBehavior="Compose">
                                    <Storyboard >
                                        <DoubleAnimation  Storyboard.TargetProperty="Width" From="100" By="10" Duration="0:0:2" RepeatBehavior="3x"
                                            ></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </TabItem>
    </TabControl>
</Window>

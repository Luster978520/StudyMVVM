<Window x:Class="StudyMVVM.Views.RenderAndRotateFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudyMVVM.Views"
        mc:Ignorable="d"
        Title="RenderAndRotateFrm" Height="450" Width="800">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation  Storyboard.TargetName="border"
                                  Storyboard.TargetProperty="Opacity"
                                  From="0.1" To="1" Duration="0:0:3">
                    </DoubleAnimation>
                    <DoubleAnimation  Storyboard.TargetName="border"
                                  Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX"
                                    From="0.1" To="1" Duration="0:0:3"
                                  AccelerationRatio="0.8">

                    </DoubleAnimation>
                    <DoubleAnimation  Storyboard.TargetName="border"
               Storyboard.TargetProperty="RenderTransform.Children[1].Angle"
                From="180" To="360" Duration="0:0:3"
               AccelerationRatio="0.8">

                    </DoubleAnimation>
                </Storyboard>


            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Grid>
            <Border x:Name="border" Margin="3" Background="LightGoldenrodYellow"
             BorderBrush="DarkBlue" BorderThickness="2" CornerRadius="5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform></ScaleTransform>
                        <RotateTransform></RotateTransform>
                    </TransformGroup>
                </Border.RenderTransform>
                <TextBlock FontSize="20" >我们生活的每一天都是一场时空穿越</TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>

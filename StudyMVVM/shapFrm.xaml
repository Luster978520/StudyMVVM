<Window x:Class="StudyMVVM.shapFrm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudyMVVM"
        mc:Ignorable="d"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behavior="clr-namespace:StudyMVVM.Behaviors1"
        Title="shapFrm" Height="750" Width="1200">
    <TabControl SelectedIndex="10">
        <TabItem Header="图像形状">


            <Grid Width="450" Height="400" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock>The first row of a grid</TextBlock>
                <!-- 缩放控制 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8">
                    <TextBlock Text="缩放：" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="scaleSlider" Minimum="0.2" Maximum="3" Value="1" Width="200" TickFrequency="0.1" IsSnapToTickEnabled="False"/>
                    <TextBlock Text="{Binding Value, ElementName=scaleSlider, StringFormat=F2}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Row="0">
                        <!-- Canvas 使用 RenderTransform 做缩放，RenderTransformOrigin 指定缩放中心为元素中心 -->
                        <Canvas Width="300"  Height="400"   RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Value, ElementName=scaleSlider}" ScaleY="{Binding Value, ElementName=scaleSlider}" />
                            </Canvas.RenderTransform>

                            <Ellipse Fill="Yellow" Stroke="Blue" StrokeThickness="2"
                  Canvas.Left="10" Canvas.Top="50"
                  Width="100" Height="100"/>
                            <Rectangle Fill="Yellow" Stroke="Blue"
                    Canvas.Left="130" Canvas.Top="40"
                    Width="120" Height="80"/>
                        </Canvas>
                    </Viewbox>
                    <Viewbox Grid.Column="1" Stretch="Fill">
                        <!-- 为 Canvas 指定大小，或确保子元素有明确的 Width/Height -->
                        <Canvas Width="400" Height="300" HorizontalAlignment="Left">
                            <Ellipse Fill="Yellow" Stroke="Blue" StrokeThickness="2"
                         Canvas.Left="10" Canvas.Top="50"
                         Width="100" Height="100"/>
                            <Rectangle Fill="Yellow" Stroke="Blue"
                           Canvas.Left="130" Canvas.Top="40"
                           Width="120" Height="80"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="画刷">
            <StackPanel>
                <Border Height="40">
                    <Border.Background>
                        <SolidColorBrush Color="Green" Opacity="0.2"/>
                    </Border.Background>
                </Border>
                <TextBlock Text="我们生活的每一天都是一场时空穿越！">
                    <TextBlock.Foreground>
                        <SolidColorBrush Color="Red"></SolidColorBrush>
                    </TextBlock.Foreground>
                </TextBlock>
                <Rectangle Width="100" Height="60"  StrokeThickness="5">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="DarkBlue"></SolidColorBrush>
                    </Rectangle.Fill>
                    <Rectangle.Stroke>
                        <SolidColorBrush Color="Green"></SolidColorBrush>
                    </Rectangle.Stroke>
                </Rectangle>
                <Ellipse x:Name="ellipse" Width="100" Height="100">

                </Ellipse>
                <Label FontSize="20" HorizontalAlignment="Center">渐变画刷</Label>
                <Rectangle Width="300" Height="100">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0 0" EndPoint="1 1">
                            <GradientStop Color="red" Offset="0"></GradientStop>
                            <GradientStop Color="blue" Offset="0.5"></GradientStop>
                            <GradientStop Color="Green" Offset="1"></GradientStop>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

            </StackPanel>
        </TabItem>
        <TabItem Header="爱心">
            <Canvas>
                <Polyline   Points="250,150 220,120 180,120 150,150 180,190 250,230 320,190 350,150 320,120 280,120 250,150" StrokeThickness="3" Cursor="Hand" Canvas.Left="-66" Canvas.Top="10" >
                    <Polyline.Fill>
                        <LinearGradientBrush 
                                         StartPoint="0 0" EndPoint="1 1">
                            <GradientStop Color="Green" Offset="0"/>
                            <GradientStop Color="blue" Offset="0.313"/>
                            <GradientStop Color="Red" Offset="1"/>
                        </LinearGradientBrush>
                    </Polyline.Fill>
                    <i:Interaction.Behaviors>
                        <behavior:CustBehavior></behavior:CustBehavior>
                    </i:Interaction.Behaviors>
                </Polyline>

                <TextBlock Text="SuperFish520" FontSize="20">
                    <TextBlock.Foreground>
                        <LinearGradientBrush 
                     StartPoint="0 0" EndPoint="1 1">
                            <GradientStop Color="Green" Offset="0"/>
                            <GradientStop Color="blue" Offset="0.4"/>
                            <GradientStop Color="Red" Offset="1"/>
                        </LinearGradientBrush>

                    </TextBlock.Foreground>
                     <i:Interaction.Behaviors>
                      <behavior:CustBehavior></behavior:CustBehavior>
                    </i:Interaction.Behaviors>
                </TextBlock>

                <Ellipse Canvas.Left="100" Canvas.Top="20" Width="100" Height="80">
                    <Ellipse.Fill>
                        <RadialGradientBrush RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="Yellow" Offset="0"/>
                            <GradientStop Color="Pink" Offset="0.4"/>
                            <GradientStop Color="Red" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <i:Interaction.Behaviors>
                        <behavior:CustBehavior></behavior:CustBehavior>
                    </i:Interaction.Behaviors>
                </Ellipse>
                <Rectangle Width="100" Height="100">
                    <Rectangle.Fill >
                        <ImageBrush ImageSource="/image/风景1.jpg"
                                    Viewbox="0.1 0.5 0.3 0.7">
                        </ImageBrush>
                    </Rectangle.Fill>
                    <i:Interaction.Behaviors>
                        <behavior:CustBehavior></behavior:CustBehavior>
                    </i:Interaction.Behaviors>
                </Rectangle>

                <Rectangle Width="230" Height="120" Canvas.Left="300" Canvas.Top="100">
                    <Rectangle.Fill >
                        <ImageBrush ImageSource="/image/风景1.jpg"
                                    ViewportUnits="RelativeToBoundingBox"
                                    TileMode="FlipXY"
                                 Viewport="0 0 0.5 0.5">
                        </ImageBrush>
                    </Rectangle.Fill>
                    <i:Interaction.Behaviors>
                        <behavior:CustBehavior></behavior:CustBehavior>
                    </i:Interaction.Behaviors>
                </Rectangle>


            </Canvas>
        </TabItem>
        <TabItem Header="VisualBrush">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="79.8"/>
                    <ColumnDefinition Width="170.2"/>
                    <ColumnDefinition Width="118.488"/>
                    <ColumnDefinition Width="19.063"/>
                    <ColumnDefinition Width="62.449"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="2">
                    <Image x:Name="visualBrushPicture" Width="100" Height="100" Source="/image/风景1.jpg"></Image>
                    <Button x:Name="visualBrushbutton" Width="80" Height="30" Background="AliceBlue" Content="按钮"></Button>

                    <Rectangle Width="200" Height=" 200">
                        <Rectangle.Fill>
                            <VisualBrush Visual="{Binding ElementName=visualBrushPicture}"/>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="80" Height=" 60">
                        <Rectangle.Fill>
                            <VisualBrush Visual="{Binding ElementName=visualBrushbutton}"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
                <StackPanel Grid.Column="2" Grid.ColumnSpan="3"  >
                    <TextBox TextWrapping="Wrap" FontSize="20" FontFamily="Arial Rounded MT Bold" 
                             Text="visualBrush 画刷只复制控件的样式，不复制控件的逻辑,复制Opacity属性。" 
                             HorizontalAlignment="Left" Width="199"></TextBox>
                </StackPanel>
                <StackPanel Grid.Column="5"  >
                    <Image x:Name="bitmapCacheBrush" Source="/image/风景1.jpg">
                    </Image>
                    <TextBlock FontFamily="Arial" FontSize="20" TextWrapping="Wrap"
                               Text="BitmapCacheBrush的图片显示更加清晰，渲染规模RenderAtScale；位图不会复制原图片的Opacity属性;复制东西少"/>
                    <Rectangle Width="200" Height="200">
                        <Rectangle.Fill>
                            <BitmapCacheBrush Target="{Binding ElementName=bitmapCacheBrush}">
                                <BitmapCacheBrush.BitmapCache>
                                    <BitmapCache RenderAtScale="10"></BitmapCache>
                                </BitmapCacheBrush.BitmapCache>
                            </BitmapCacheBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="变换">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>

                    <TextBox FontFamily="Algerian" FontSize="20" Text="变换" ></TextBox>
                    <TextBox FontFamily="Algerian" FontSize="20" Text="旋转"></TextBox>
                    <TextBox FontFamily="Algerian" FontSize="20" Text="缩放"></TextBox>
                    <TextBox FontFamily="Algerian" FontSize="20" Text="三个主要属性"></TextBox>
                    <TextBox FontFamily="宋体" FontSize="20" 
                             Text="RenderTransformOrigin CenterY CenterX"></TextBox>
                    <TextBox FontFamily="宋体" FontSize="20" Text="缩放 ScanleTransform(倒影) ScaleX ScaleY"></TextBox>
                    <TextBox TextWrapping="Wrap" FontFamily="宋体" FontSize="20" Text="CenterX CenterY 旋转中心 绝对坐标值"></TextBox>
                    <TextBox TextWrapping="Wrap" FontFamily="宋体" FontSize="20" Text=" 相对坐标值：写到元素上 渲染变换的起始点 RenderTransformOrigin"></TextBox>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Slider x:Name="scaleSlider1" Width="150" Height="20" Minimum="0" Maximum="4" Value="1"></Slider>
                    </StackPanel>
                    <Canvas Grid.Row="1">
                        <Rectangle Fill="Green" Width="80" Height="10" Canvas.Left="100" Canvas.Top="100"></Rectangle>
                        <Rectangle Fill="Green" Width="80" Height="10" Canvas.Left="100" Canvas.Top="100">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45"></RotateTransform>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Fill="Green" Width="80" Height="10" Canvas.Left="100" Canvas.Top="100">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="90" ></RotateTransform>

                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Fill="Green" Width="80" Height="10" Canvas.Left="100" Canvas.Top="100">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="135"></RotateTransform>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Button Content="按钮" Width="80" Height="40" Background="AntiqueWhite" Canvas.Left="100" Canvas.Top="200"
                            RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <RotateTransform Angle="20"></RotateTransform>
                            </Button.RenderTransform>
                        </Button>
                        <Button Content="按钮" Width="80" Height="40" Background="AntiqueWhite" Canvas.Left="100" Canvas.Top="300"
         RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <RotateTransform Angle="75"></RotateTransform>
                            </Button.RenderTransform>
                        </Button>

                        <Rectangle Fill="Green" Width="80" Height="10" Canvas.Left="200" Canvas.Top="100" RenderTransformOrigin="0.5 0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ElementName=scaleSlider1, Path=Value}"></ScaleTransform>
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <Image x:Name="ImageReflect" Width="200" Canvas.Left="300" Canvas.Top="100" Source="/image/风景1.jpg"></Image>
                        <Rectangle Width="{Binding ElementName=ImageReflect, Path=ActualWidth}" Height="{Binding ElementName=ImageReflect, Path=ActualHeight}" Canvas.Left="300" Canvas.Top="230" RenderTransformOrigin="0.5 0.5" >
                            <Rectangle.Fill>
                                <VisualBrush Visual="{Binding ElementName=ImageReflect}"/>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleY="-1"></ScaleTransform>
                            </Rectangle.RenderTransform>
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"></GradientStop>
                                    <GradientStop Color="Green" Offset="1"></GradientStop>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                    </Canvas>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="路径和几何图形">
            <Grid ShowGridLines="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="17*"/>
                    <ColumnDefinition Width="125*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <Line Grid.Row="0" Grid.Column="0" X1="0" Y1="0" X2="100" Y2="100" Stroke="Red" Grid.ColumnSpan="2"></Line>
                <Path Grid.Row="1" Grid.Column="0" Stroke="Green" Margin="0,10,0,10" Grid.ColumnSpan="2">
                    <Path.Data>
                        <LineGeometry StartPoint="0 0"  EndPoint="200 100"/>
                    </Path.Data>
                </Path>
                <Rectangle Grid.Row="2" Grid.Column="1" Height="100" Width="200" Fill="Yellow" Margin="278,0,397,50" Grid.RowSpan="2"></Rectangle>
                <Path Fill="Yellow" Stroke="Blue" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                    <Path.Data>
                        <RectangleGeometry Rect="0 0 100 50"></RectangleGeometry>
                    </Path.Data>
                </Path>

                <Path Grid.Row="4" Grid.Column="1" Fill="BlueViolet" Margin="181,50,100,0">
                    <Path.Data>
                        <EllipseGeometry RadiusX="100" RadiusY="80"/>
                    </Path.Data>
                </Path>

                <Path Fill="Coral" Width="100" Height="100" Grid.Row="5" Grid.Column="1" Margin="328,0,447,0">
                    <Path.Data>
                        <GeometryGroup FillRule="EvenOdd">
                            <RectangleGeometry Rect="0 0 100 100"></RectangleGeometry>
                            <EllipseGeometry RadiusX="50" RadiusY="30" Center="50 50"></EllipseGeometry>
                        </GeometryGroup>
                    </Path.Data>
                </Path>
                <TextBlock  Grid.Row="0" Grid.Column="2" Text="直线line"></TextBlock>
                <TextBlock Grid.Column="2" Text="直线Path path.data LineGeometry" Margin="0,100,0,100" Grid.RowSpan="3"/>
                <TextBlock  Grid.Row="2" Grid.Column="2" Text="矩形 rectangle" Margin="0,0,0,50" Grid.RowSpan="2" ></TextBlock>
                <TextBlock  Grid.Row="3" Grid.Column="2" Text="矩形 RectagnleGeometry"></TextBlock>
                <TextBlock  Grid.Row="3" Grid.Column="2" Text="椭圆 EllipseGeometry" Margin="0,50,0,0" Grid.RowSpan="2"></TextBlock>
                <TextBlock  TextWrapping="Wrap" Grid.Row="4" Grid.Column="2" Text="GeometryGroup 属性FillRule EventOld非  NonZero并 奇偶填充 奇数填充，偶数不填充" Margin="0,130,0,0" Grid.RowSpan="2"></TextBlock>

            </Grid>
        </TabItem>
        <TabItem Header="融合图形">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="144*"/>
                    <ColumnDefinition Width="55*"/>
                    <ColumnDefinition Width="199*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="2">
                    <ComboBox x:Name="cbbCombined" Width="100" Height="30" SelectedIndex="1" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem>Union</ComboBoxItem>
                        <ComboBoxItem>Intersect</ComboBoxItem>
                        <ComboBoxItem>Exclude</ComboBoxItem>
                        <ComboBoxItem>Xor</ComboBoxItem>
                    </ComboBox>
                    <Path x:Name="combinedGeometryPathTest" Fill="Yellow" Stroke="Blue" StrokeThickness="2" Margin="5" Height="100" Width="200">
                        <Path.Data>
                            <!-- 加上 GeometryCombineMode="Union" -->
                            <CombinedGeometry  GeometryCombineMode="Union">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0 0 100 100"></RectangleGeometry>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="85 50" RadiusX="65" RadiusY="35"></EllipseGeometry>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>
                    <Path Fill="Yellow" Stroke="Blue" StrokeThickness="2" Margin="5" Height="100" Width="200">
                        <Path.Data>
                            <!-- 加上 GeometryCombineMode="Union" -->
                            <CombinedGeometry GeometryCombineMode="Intersect">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0 0 100 100"></RectangleGeometry>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="85 50" RadiusX="65" RadiusY="35"></EllipseGeometry>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                    <Path Fill="Yellow" Stroke="Blue" StrokeThickness="2" Margin="5" Height="100" Width="200">
                        <Path.Data>
                            <!-- 加上 GeometryCombineMode="Union" -->
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0 0 100 100"></RectangleGeometry>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="85 50" RadiusX="65" RadiusY="35"></EllipseGeometry>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                    <Path Fill="Yellow" Stroke="Blue" StrokeThickness="2" Margin="5" Height="100" Width="200">
                        <Path.Data>
                            <!-- 加上 GeometryCombineMode="Union" -->
                            <CombinedGeometry GeometryCombineMode="Xor">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0 0 100 100"></RectangleGeometry>
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <EllipseGeometry Center="85 50" RadiusX="65" RadiusY="35"></EllipseGeometry>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                    <Path Fill="red" Stroke="Blue">
                        <Path.Data>
                            <!--第一个图形-->
                            <CombinedGeometry GeometryCombineMode="Union">
                                <CombinedGeometry.Geometry1>
                                    <CombinedGeometry GeometryCombineMode="Exclude">
                                        <!--第一个图形中的第一个图形-->
                                        <CombinedGeometry.Geometry1>
                                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"></EllipseGeometry>
                                        </CombinedGeometry.Geometry1>
                                        <!--第一个图形中的第二个图形-->
                                        <CombinedGeometry.Geometry2>
                                            <EllipseGeometry Center="50,50" RadiusX="40" RadiusY="40"></EllipseGeometry>
                                        </CombinedGeometry.Geometry2>
                                    </CombinedGeometry>
                                </CombinedGeometry.Geometry1>

                                <!--第二个图形中-->
                                <CombinedGeometry.Geometry2>
                                    <RectangleGeometry Rect="44,5 10,90">
                                        <RectangleGeometry.Transform>
                                            <RotateTransform Angle="45" CenterX="50" CenterY="50"></RotateTransform>
                                        </RectangleGeometry.Transform>
                                    </RectangleGeometry>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Path Fill="White" Stroke="Black" StrokeThickness="2" Margin="20" Width="300" Height="300">
                        <Path.Data>
                            <!-- 外层合并：头部 + 两只耳朵 Union合并 -->
                            <CombinedGeometry GeometryCombineMode="Union">
                                <!-- Geometry1：兔子头部，Exclude挖空两只眼睛 -->
                                <CombinedGeometry.Geometry1>
                                    <CombinedGeometry GeometryCombineMode="Exclude">
                                        <CombinedGeometry.Geometry1>
                                            <!-- 大圆：脑袋 -->
                                            <EllipseGeometry Center="50,60" RadiusX="40" RadiusY="35"/>
                                        </CombinedGeometry.Geometry1>
                                        <CombinedGeometry.Geometry2>
                                            <!-- 两个眼睛（GeometryGroup放多个挖空图形，Exclude一次性挖掉） -->
                                            <GeometryGroup>
                                                <EllipseGeometry Center="35,50" RadiusX="5" RadiusY="7"/>
                                                <EllipseGeometry Center="65,50" RadiusX="5" RadiusY="7"/>
                                            </GeometryGroup>
                                        </CombinedGeometry.Geometry2>
                                    </CombinedGeometry>
                                </CombinedGeometry.Geometry1>
                                <!-- Geometry2：两只长耳朵，Union合并到脑袋上 -->
                                <CombinedGeometry.Geometry2>
                                    <CombinedGeometry GeometryCombineMode="Union">
                                        <CombinedGeometry.Geometry1>
                                            <!-- 左耳 -->
                                            <EllipseGeometry Center="25,15" RadiusX="12" RadiusY="28"/>
                                        </CombinedGeometry.Geometry1>
                                        <CombinedGeometry.Geometry2>
                                            <!-- 右耳 -->
                                            <EllipseGeometry Center="75,15" RadiusX="12" RadiusY="28"/>
                                        </CombinedGeometry.Geometry2>
                                    </CombinedGeometry>
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Path.Data>
                    </Path>

                </StackPanel>
            </Grid>


        </TabItem>
        <TabItem Header="Chatgpt">
            <Grid Background="#101020">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="481*"/>
                    <ColumnDefinition Width="713*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Stretch="Uniform" Grid.ColumnSpan="2">
                    <Canvas Width="300" Height="340">

                        <!-- 背部装饰：机械光环 -->
                        <Ellipse Width="220" Height="220"
                     Canvas.Left="40" Canvas.Top="35"
                     Stroke="#00FFFF"
                     StrokeThickness="2"
                     Opacity="0.8"/>

                        <Ellipse Width="190" Height="190"
                     Canvas.Left="55" Canvas.Top="50"
                     Stroke="#FF00FF"
                     StrokeThickness="1.5"
                     StrokeDashArray="4 4"/>

                        <!-- 头骨主体 -->
                        <Path Fill="#DCE7F0"
                  Stroke="#00FFFF"
                  StrokeThickness="2"
                  Data="M 70,105
                        C 55,65 85,35 150,35
                        C 215,35 245,65 230,105
                        L 220,170
                        L 205,205
                        L 195,250
                        L 175,265
                        L 125,265
                        L 105,250
                        L 95,205
                        L 80,170 Z"/>

                        <!-- 左眼窝 -->
                        <Path Fill="#101020"
                  Stroke="#FF00FF"
                  StrokeThickness="2"
                  Data="M 80,115
                        L 120,100
                        L 115,145
                        L 90,155 Z"/>

                        <!-- 右眼窝 -->
                        <Path Fill="#101020"
                  Stroke="#00FFFF"
                  StrokeThickness="2"
                  Data="M 180,100
                        L 220,115
                        L 210,155
                        L 185,145 Z"/>

                        <!-- 左眼发光核心 -->
                        <Ellipse Width="15" Height="15"
                     Canvas.Left="94" Canvas.Top="120"
                     Fill="#FF00FF"/>

                        <!-- 右眼发光核心 -->
                        <Ellipse Width="15" Height="15"
                     Canvas.Left="191" Canvas.Top="120"
                     Fill="#00FFFF"/>

                        <!-- 鼻骨 -->
                        <Path Fill="#101020"
                  Stroke="#FF00FF"
                  StrokeThickness="1.5"
                  Data="M 145,155
                        L 155,155
                        L 165,180
                        L 150,190
                        L 135,180 Z"/>

                        <!-- 颧骨机械装饰 -->
                        <Path Stroke="#00FFFF"
                  StrokeThickness="3"
                  Fill="Transparent"
                  Data="M 70,165 L 105,180 L 125,205
                        M 230,165 L 195,180 L 175,205"/>

                        <!-- 嘴部黑色区域 -->
                        <Path Fill="#101020"
                  Stroke="#00FFFF"
                  StrokeThickness="2"
                  Data="M 110,205
                        L 190,205
                        L 185,245
                        L 165,255
                        L 135,255
                        L 115,245 Z"/>

                        <!-- 机械牙齿 -->
